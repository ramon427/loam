{
  "name": "loam",
  "private": true,
  "type": "module",
  "description": "Loam: a free, open-source, local-first notes app with linked notes, diagrams and video study.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev --",
    "build": "npm --prefix apps/desktop run build",
    "start": "npm --prefix apps/desktop run build && npm --prefix apps/desktop run start",
    "mcp": "node apps/desktop/dist-electron/mcp.cjs",
    "package:win": "npm --prefix apps/desktop run package:win",
    "package:mac": "npm --prefix apps/desktop run package:mac",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.node.json --noEmit && tsc -p apps/desktop/tsconfig.renderer.json --noEmit && tsc -p examples/plugins --noEmit && tsc -p apps/desktop/plugins --noEmit",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip --no-progress --no-config-hints",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run format:check && npm test",
    "postinstall": "patch-package --error-on-fail",
    "bench": "vitest run --config vitest.bench.config.ts",
    "windows-zones": "node scripts/generateWindowsZones.ts",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "friction": "npm run build && rm -rf tmp/friction && playwright test -c e2e/friction/playwright.config.ts; node e2e/friction/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@blocknote/core": "0.51.4",
    "@blocknote/react": "0.51.4",
    "@blocknote/shadcn": "0.51.4",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@emoji-mart/data": "1.2.1",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-virtual": "3.14.5",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx-preview": "0.3.7",
    "ecij": "0.4.1",
    "electron-updater": "6.8.9",
    "framer-motion": "12.42.2",
    "jszip": "3.10.1",
    "lucide-react": "1.56.0",
    "openai": "7.32.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.7",
    "react-data-grid": "7.0.0-beta.60",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "knip": "6.41.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "prosemirror-view": "1.42.4",
    "prosemirror-transform": "1.12.0",
    "prosemirror-model": "1.25.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "homepage": "https://github.com/ramon427/loam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramon427/loam.git"
  },
  "bugs": "https://github.com/ramon427/loam/issues"
}

{
  "id": "google-calendar",
  "name": "Calendar",
  "version": "2.1.0",
  "description": "Your Google calendars and your Outlook or other calendars in one view: see, make, move and change Google events by day, week or month, see subscribed calendars beside them, and start a meeting note from any event.",
  "author": "Loam",
  "apiVersion": 1,
  "permissions": [
    "ui",
    "google:calendar",
    "notes:write",
    "network:calendar.google.com",
    "network:outlook.office365.com",
    "network:outlook.office.com",
    "network:outlook.live.com"
  ],
  "settings": [
    {
      "key": "weekStart",
      "type": "select",
      "label": "Weeks start on",
      "options": [
        {
          "value": "monday",
          "label": "Monday"
        },
        {
          "value": "sunday",
          "label": "Sunday"
        },
        {
          "value": "saturday",
          "label": "Saturday"
        }
      ],
      "default": "monday"
    },
    {
      "key": "workingHoursStart",
      "type": "number",
      "label": "Working hours start",
      "description": "The hour (0 to 23) the working day starts; the hours outside it are shaded.",
      "default": 9
    },
    {
      "key": "workingHoursEnd",
      "type": "number",
      "label": "Working hours end",
      "description": "The hour (1 to 24) the working day ends.",
      "default": 17
    },
    {
      "key": "defaultDuration",
      "type": "select",
      "label": "Default event length",
      "options": [
        {
          "value": "15",
          "label": "15 minutes"
        },
        {
          "value": "30",
          "label": "30 minutes"
        },
        {
          "value": "45",
          "label": "45 minutes"
        },
        {
          "value": "60",
          "label": "1 hour"
        },
        {
          "value": "90",
          "label": "1.5 hours"
        },
        {
          "value": "120",
          "label": "2 hours"
        }
      ],
      "default": "60"
    },
    {
      "key": "defaultReminder",
      "type": "select",
      "label": "Notification for new events",
      "options": [
        {
          "value": "calendar",
          "label": "The calendar's default"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "0",
          "label": "At the start"
        },
        {
          "value": "5",
          "label": "5 minutes before"
        },
        {
          "value": "10",
          "label": "10 minutes before"
        },
        {
          "value": "30",
          "label": "30 minutes before"
        },
        {
          "value": "60",
          "label": "1 hour before"
        },
        {
          "value": "1440",
          "label": "1 day before"
        }
      ],
      "default": "calendar"
    },
    {
      "key": "showDeclined",
      "type": "boolean",
      "label": "Show events you declined",
      "default": true
    },
    {
      "key": "cancelledEvents",
      "type": "select",
      "label": "Cancelled meetings",
      "description": "Outlook keeps a cancelled meeting in the calendar until it is removed.",
      "options": [
        {
          "value": "show",
          "label": "Show struck through"
        },
        {
          "value": "hide",
          "label": "Hide"
        }
      ],
      "default": "show"
    },
    {
      "key": "urls",
      "type": "string",
      "label": "Secret iCal addresses",
      "description": "Moved to the calendar's Subscribed calendars.",
      "hidden": true
    }
  ]
}
